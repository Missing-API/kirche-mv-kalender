{
  "name": "kirche-mv",
  "version": "1.3.0",
  "description": "Middleware zur Optimierung der Veranstaltungskalenderdaten von kirche-mv.de",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3060",
    "build": "next build",
    "start": "next start -p 3060",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "next typegen && tsc --noEmit"
  },
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "@schafevormfenster/data-text-mapper": "^0.1.0",
    "axios": "^1.21.1",
    "axios-cache-interceptor": "^1.13.0",
    "cheerio": "^1.2.0",
    "ics": "^3.12.1",
    "next": "16.4.6",
    "next-swagger-doc": "0.5.0",
    "node-ical": "^0.27.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swagger-ui-react": "5.35.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/swagger-ui-react": "5.18.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react-inspector>react": "19",
        "react-debounce-input>react": "19",
        "eslint-plugin-import>eslint": "10",
        "eslint-plugin-jsx-a11y>eslint": "10",
        "eslint-plugin-react>eslint": "10"
      }
    }
  }
}
